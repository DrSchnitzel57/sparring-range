# .gitignore — secrets stay out of git (hard constraint #5)
.env
.venv/
__pycache__/
*.pyc
recordings/
*.cast
.pytest_cache/
*.egg-info/
web/node_modules/
web/.next/
web/.next-e2e/
web/.e2e-builds/
web/npm-install.log
.playwright-cli/
/Claude outputs
# Generated identity material — private keys never enter git (audit F07)
*_ed25519
*_ed25519.pub
id_*
*.pem
known_hosts
# Local admin/env helper files with credentials (explicitly NOT committed)
.env.local
pgadmin.env
# npm
web/package-lock.json.orig
.safety_state*
# junk accidentally created at repo root by a buggy test (key-object repr used as filename)
*object at 0x*
.baseline*.log
