# sparring-range control-plane environment (pilot step 7)
# Copy to /etc/sparring-range/control-plane.env (chmod 0640, root:sr-range).
# Values marked CHANGE are operator-specific; nothing here is a model or
# range credential the model could ever see.

SR_ENV=production
SR_PROCESS_ROLE=controller

# --- database (PostgreSQL 16 on this VM; roles created by deploy/README) ---
POSTGRES_URL=postgresql+psycopg2://sr_app:CHANGE@127.0.0.1:5432/sparring_range
POSTGRES_URL_OWNER=postgresql+psycopg2://sr_owner:CHANGE@127.0.0.1:5432/sparring_range
DB_APP_ROLE=sr_app

# --- API / web ---
# API_BASE_URL is DERIVED from the manifest (urls.public_https).
# Uncomment to override deliberately (must still be https + non-localhost).
#API_BASE_URL=https://CHANGE-LAN-IP
API_ALLOWED_ORIGINS=https://CHANGE-LAN-IP
# Public CA whose certificate serves the API the guests dial (plan 13
# phase 4). Provisioned into every enrolled guest as
# /etc/sparring-range/tls/api-ca.crt; the shipper verifies with an explicit
# trust anchor — TLS checks are never disabled.
# SR_TELEMETRY_CA_FILE is DERIVED (fixed trust-anchor path).
#SR_TELEMETRY_CA_FILE=/etc/sparring-range/tls/api-ca.crt
BASTION_ADDRESS=CHANGE-LAN-IP
BASTION_LISTEN_PORT=2222

# --- model gateway (inference LXC; inference-only, outside the range) ---
# LLM_BASE_URL/_MODEL_RED/_MODEL_COACH are DERIVED from the manifest
# (model.base_url/alias). Uncomment to override deliberately.
#LLM_BASE_URL=http://10.10.10.197:8096/v1
#LLM_MODEL_RED=qwen3.8-flash-next
#LLM_MODEL_COACH=qwen3.8-flash-next
LLM_TIMEOUT_S=60

# --- broker (mutually authenticated TLS) ---
BROKER_URL=https://broker.range.internal:8443
BROKER_CLIENT_CERT=/etc/sparring-range/tls/api-client.crt
BROKER_CLIENT_KEY=/etc/sparring-range/tls/api-client.key
BROKER_TLS_CA_FILE=/etc/sparring-range/tls/ca.crt
PROXMOX_TLS_CA_FILE=/etc/sparring-range/tls/ca.crt
# Exact PVE node name (`ls /etc/pve/nodes/` or `pvesh get /nodes` — PVE 9.2
# `pveum` has NO node command). REQUIRED — the code default is a
# dev-box leftover and the broker rejects any node its policy doesn't name.
# PROXMOX_NODE is DERIVED from the manifest (pve.node).
#PROXMOX_NODE=pve
# First allocatable VMID — must equal the broker policy's vmid range start.
# DEPLOY_VMID_BASE is DERIVED from the manifest (pve.clone_vmid_range).
#DEPLOY_VMID_BASE=9100
# Range bridge on the PVE node — must equal the broker policy's nic.bridge.
# RANGE_BRIDGE is DERIVED from the manifest (network.bridge).
#RANGE_BRIDGE=srrange
# Must equal the broker policy's clone_mode ('full' for real ranges: clones
# never share the template's disk; the code default 'linked' is a dev value).
# DEPLOY_CLONE_MODE is DERIVED from the manifest (storage.clone_mode).
#DEPLOY_CLONE_MODE=full

# --- bastion: dial guests as defender with the generation key ---
BASTION_TARGET_USER=defender
BASTION_CLIENT_KEY_PATH=/etc/sparring-range/ssh/bastion_ed25519
BASTION_AUTHORIZED_KEYS_FILE=/etc/sparring-range/authorized_keys
BASTION_TARGETS_KNOWN_HOSTS=/var/lib/sparring-range/known_hosts.bastion
BASTION_HOST_KEY_PATH=/etc/sparring-range/ssh/bastion_host_ed25519

# --- match lifecycle (pilot step 4) ---
SR_MATCH_SCHEDULER_ENABLED=1
SR_MATCH_DEFAULT_DURATION_MINUTES=30
SR_MATCH_DEFAULT_PACE_SECONDS=30

# --- recordings / data ---
RECORDINGS_DIR=/var/lib/sparring-range/recordings
SR_DATA_DIR=/var/lib/sparring-range

# --- verifier/management SSH into guests (operator key, NOT in git) ---
VERIFIER_SSH_USER=root
VERIFIER_SSH_KEY_PATH=/var/lib/sparring-range/ssh/verifier_ed25519
VERIFIER_SSH_KNOWN_HOSTS=/var/lib/sparring-range/known_hosts.verifier

# --- isolated AI runner: SSH into the attacker guest (fixed scenario IP;
# key is the generation keypair's private half, mode 0600 owned by srrange;
# known_hosts files are written by the deploy from broker-pinned guest keys)
RUNNER_SSH_TARGET=attacker@10.66.0.9
RUNNER_SSH_KEY_PATH=/var/lib/sparring-range/ssh/runner_ed25519
RUNNER_SSH_KNOWN_HOSTS=/var/lib/sparring-range/known_hosts.runner

# --- plan 13 phase 4: release-stage ladder -------------------------------
# Explicit operator authorization: set to 1 ONLY after isolation and
# emergency-stop verification (docs/OPERATOR_RUNBOOK.md). A successful
# deployment never implies it; GET /stages reports the three stages.
SR_ATTACK_AUTHORIZED=0
# --- plan 13 phase 5: durable lifecycle operations ------------------------
# Declared bound for one launch/reset attempt, recorded BEFORE dispatch so
# pollers and startup reconciliation see the same deadline.
SR_DEPLOY_OPERATION_DEADLINE_S=900
