[Unit]
Description=sparring-range recording bastion (recorded SSH, port 2222)
After=network-online.target sr-api.service

[Service]
Type=exec
User=srbastion
Group=srbastion
# The bastion loads ONLY its own environment: the API it reports to, the
# member's authorized keys, its own host key and the key it presents to the
# practice guests.  It never loads the controller's environment (the
# worker-supervisor capability) and never the database credential.
EnvironmentFile=/etc/sparring-range/control-plane.bastion.env
WorkingDirectory=/opt/sparring-range
ExecStart=/opt/sparring-range/.venv/bin/python -m srplatform.bastion.proxy
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sparring-range
PrivateTmp=true

[Install]
WantedBy=multi-user.target
