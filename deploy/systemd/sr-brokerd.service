[Unit]
Description=sparring-range private broker (sole Proxmox authority)
After=network-online.target

[Service]
Type=exec
User=srbroker
Group=srbroker
EnvironmentFile=/etc/sparring-range/broker.env
WorkingDirectory=/opt/sparring-range
ExecStart=/opt/sparring-range/.venv/bin/python -m infra.broker
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sparring-range
PrivateTmp=true

[Install]
WantedBy=multi-user.target
