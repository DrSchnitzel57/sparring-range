# sparring-range BROKER VM environment (pilot step 7)
# Copy to /etc/sparring-range/broker.env (chmod 0640). The broker VM holds
# the ONLY Proxmox credential in the system; the control plane never has it.

SR_ENV=production
SR_PROCESS_ROLE=broker

BROKER_LISTEN_HOST=0.0.0.0
BROKER_LISTEN_PORT=8443
BROKER_SERVER_CERT=/etc/sparring-range/tls/broker-server.crt
BROKER_SERVER_KEY=/etc/sparring-range/tls/broker-server.key
BROKER_TLS_CA_FILE=/etc/sparring-range/tls/ca.crt
BROKER_POLICY_FILE=/etc/sparring-range/broker-policy.json
BROKER_LEDGER_PATH=/var/lib/sparring-range/broker-ledger.sqlite3

# Restricted PVE API token: the lab resources in the policy file ONLY
# (Datastore.AllocateSpace, VM.Audit, VM.Clone, VM.Config.Network,
# VM.PowerMgmt on the template/VMID range + storage; never Admin.*).
PROXMOX_HOST=pve.range.internal
PROXMOX_NODE=<from broker-policy.json>
PROXMOX_TOKEN_ID=sr-broker@pve!range
PROXMOX_TOKEN_SECRET=CHANGE
PROXMOX_TLS_CA_FILE=/etc/sparring-range/tls/pve-ca.crt
