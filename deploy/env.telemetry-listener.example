# Overrides for the listener on the controller's RANGE address (plan 13
# phase 4). The control plane runs the SAME app on three planes: trusted
# local processes on loopback, users on the LAN HTTPS front, and GUESTS on
# this listener. Load this file AFTER env.control-plane; its only job is to
# shrink the guest-facing surface to the authenticated enrollment/ingest
# routes — every other path answers 404 and bodies are bounded. A
# compromised guest therefore reaches no general API/web/auth/scoring/
# model/operator endpoint from the range.
SR_ENV=production
SR_API_INGEST_ONLY=1
# The certificate served on this plane must carry a SAN matching the range
# address and be signed by the CA provisioned into guests (api-ca.crt).
SR_API_BASE_URL=https://10.66.0.1:8444
SR_TELEMETRY_CA_FILE=/etc/sparring-range/tls/api-ca.crt
