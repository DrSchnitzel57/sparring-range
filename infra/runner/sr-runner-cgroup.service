# Plan 13 phase 3 — reboot-persistent runner cgroup delegation (attacker).
# Creates a cgroup v2 subtree owned by the `attacker` user so the runner
# supervisor can create per-operation containment groups WITHOUT root and
# WITHOUT any global security relaxation. The runner writes its group
# leader into <child>/cgroup.procs and kills via cgroup.kill — both require
# the delegated ownership this unit establishes on every boot.
[Unit]
Description=sparring-range runner cgroup delegation
Documentation=file:/usr/local/bin/runner-supervisor
After=local-fs.target systemd-logind.service
Requires=systemd-logind.service
Before=ssh.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/sr-runner-cgroup-setup

[Install]
WantedBy=multi-user.target
