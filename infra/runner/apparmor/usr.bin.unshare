# Plan 13 phase 3 — SCOPED AppArmor profile for the runner's trusted
# launcher (attacker guest). Ubuntu 24.04 restricts unprivileged user
# namespaces to AppArmor-confined transitions; instead of relaxing that
# globally (kernel.apparmor_restrict_unprivileged_userns=0), the runner's
# boundary launcher /usr/bin/unshare is confined by this profile
# (upstream apparmor bwrap-userns-restrict pattern). A real confined
# profile keeps its permissions inside the namespace and exec'd children
# (bash, mount, the operation command) inherit it via `/** rix,`.
# Loaded at boot by apparmor.service from /etc/apparmor.d — reboot-persistent.

abi <abi/4.0>,
include <tunables/global>

profile unshare /usr/bin/unshare flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow userns,
  allow mount,
  allow umount,

  # EXEC grant with profile INHERITANCE: under abi/4.0 (policy v6) the
  # file 'm' bit is mmap-exec, NOT execute — without an x rule the
  # confined unshare cannot exec sh inside the boundary (EACCES). 'ix'
  # keeps every exec'd child (bash, mount, the operation command) in this
  # profile so capability/mount stay available inside the namespace.
  /** rix,

  include if exists <local/unshare>
}
