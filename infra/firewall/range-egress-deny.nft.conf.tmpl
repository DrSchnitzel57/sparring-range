# Range egress-deny firewall rules — Proxmox datacenter/bridge level (pve8 nftables)
# RENDER THIS TEMPLATE and apply on the R740 (Drew): it is what enforces
# hard constraint #1 — the range VLAN has NO WAN egress, default-deny.
#
# Variables: {{RANGE_BRIDGE}} {{RANGE_VLAN}} {{GPU_SERVING_CIDR}} {{CONTROL_PLANE_CIDR}}
# The platform reaches the model endpoint from the CONTROL PLANE side only;
# nothing on the range gets outbound internet, period.

# --- applied on the Proxmox host for the range bridge ---
# On pve8 this lands as nftables ruleset 'pve-firewall'; equivalent below.

table inet sparring_range_denied comment "sparring-range: default-deny egress on {{RANGE_BRIDGE}}";

chain forward_from_range {
    type filter hook forward priority 0; policy drop;   # default-DENY, not default-allow

    # established/related back into the range are fine (return traffic)
    ct state established,related accept

    # range -> control plane (event shipping, bastion management) — explicit allow
    oifname != "{{RANGE_BRIDGE}}" iifname "{{RANGE_BRIDGE}}" ip daddr {{CONTROL_PLANE_CIDR}} accept

    # everything else out of the range dies here. No DNS, no ping, no HTTP.
    # The whitelisted update proxy (if ever enabled) would be a single explicit
    # rule above this; it is OFF by default.
}
