#!/bin/sh
# DELIBERATE LAB FLAW (paired 03+04 + pilot step 1): misconfigured guest
# maintenance helper. Root-owned and invoked by the web app through the
# tightly scoped sudo rule /etc/sudoers.d/mojang-maintenance (NOPASSWD).
# FLAW: it prepends the APPLICATION-OWNED tools directory to PATH, so a
# web-user-writable `backup-tool` in /srv/mojang-web/tools executes as ROOT
# (documented guest-root escalation path).
# (The old setuid-on-a-script variant NEVER worked: Linux ignores the setuid
# bit on interpreter scripts — that is why this path is a sudo rule.)
# Documented fix (preserves service): revoke the rule
#   rm -f /etc/sudoers.d/mojang-maintenance
# (and/or pin PATH inside this script), then verify `mojang-web` + `nginx`
# are still active. The helper itself stays installed.
set -eu
PATH="/srv/mojang-web/tools:$PATH"
logger -t mojang-maintenance "maintenance run by $(id -un) uid=$(id -u)"
backup-tool --compress /srv/mojang-web
