[Unit]
Description=Mojang fictional shop (web+DB data)
After=network.target

[Service]
User=web-user
Group=web-user
EnvironmentFile=/etc/mojang-web/config.env
ExecStart=/usr/bin/python3 /srv/mojang-web/app.py
Restart=always
# LAB FLAW CONTEXT (pilot step 1): NoNewPrivileges is deliberately NOT set
# here because the documented maintenance-helper escalation needs a privilege
# transition from the web-user service. Re-adding `NoNewPrivileges=true` is a
# hardening fix that blocks the escalation while the service stays ready —
# see /srv/mojang-web/FIXES.md.

[Install]
WantedBy=multi-user.target
