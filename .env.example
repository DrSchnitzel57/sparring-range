# ============================================================
# sparring-range — every environment variable, documented, NO SECRETS.
# Copy to .env (gitignored) and fill in. Field names map 1:1 to
# srplatform/settings.py (pydantic-settings, uppercase).
# In SR_ENV=production, placeholder/empty critical values are REJECTED
# at startup (F23) — misconfiguration fails closed.
# ============================================================

# --- Mode ----------------------------------------------------------------------
# dev: local-dev runner allowed, evidence gate relaxed (documented in
#      docs/ARCHITECTURE_NOTES.md). production: enforced everywhere.
SR_ENV=dev

# --- Database ------------------------------------------------------------------
# API/CLI application role (append-only on events; no DDL).
POSTGRES_URL=postgresql+psycopg2://sr_app:CHANGE_ME@localhost:5432/sparring_range
# Schema-owner role, used ONLY by `rangectl db migrate`.
POSTGRES_URL_OWNER=postgresql+psycopg2://sr_owner:CHANGE_ME@localhost:5432/sparring_range
DB_APP_ROLE=sr_app

# --- API (single front door; CLI and web are plain authenticated clients) -------
API_BASE_URL=http://localhost:8000
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# User session tokens expire; login requires username AND password (F04).
WEB_TOKEN_TTL_HOURS=12
# The ONLY username allowed to self-bootstrap while no account has a password.
BOOTSTRAP_OPERATOR_USERNAME=drew

# --- Proxmox control plane (BROKER ROLE ONLY — milestone 02) -----------------
# These belong to the broker VM (SR_PROCESS_ROLE=broker). The controller/API
# must NOT hold PVE credentials: production validation REFUSES a controller
# that has PROXMOX_TOKEN_ID/SECRET set.
PROXMOX_HOST=r740.lab.local
PROXMOX_NODE=r740
PROXMOX_USER=root@pam
# Token = user@realm!name (Datacenter → Permissions → API Tokens).
PROXMOX_TOKEN_ID=automation!sparring
PROXMOX_TOKEN_SECRET=CHANGE_ME
PROXMOX_TLS_VERIFY=True
# PROXMOX_TLS_CA_FILE=/etc/ssl/private/pve-ca.pem
# Lab-only escape hatch; production refuses to start with this set True:
PROXMOX_INSECURE_LAB_OVERRIDE=False
PROXMOX_TASK_TIMEOUT_S=300

# --- Deployment broker (milestone 02) ------------------------------------------
# The broker is the ONLY component that may hold PVE authority; the API
# reaches it over mutual TLS and nothing else.
# Controller (API) side:
BROKER_URL=https://broker.lab.local:8443
BROKER_TLS_CA_FILE=/etc/sparring-range/broker_ca.pem
BROKER_CLIENT_CERT=/etc/sparring-range/broker_client.pem
BROKER_CLIENT_KEY=/etc/sparring-range/broker_client.key
BROKER_HEARTBEAT_S=5
# Broker role (SR_PROCESS_ROLE=broker) additionally needs:
# BROKER_POLICY_FILE=/etc/sparring-range/broker_policy.json  (operator allowlist — REQUIRED)
# BROKER_LEDGER_PATH=/var/lib/sparring-range/broker/ledger.sqlite3
# BROKER_LISTEN_HOST=0.0.0.0
# BROKER_LISTEN_PORT=8443
# BROKER_SERVER_CERT=/etc/sparring-range/broker_server.pem
# BROKER_SERVER_KEY=/etc/sparring-range/broker_server.key
# Synthetic in-process broker for ISOLATED fixtures only (never production):
# SR_BROKER_FIXTURE=1

# --- Range network (default-deny datapath) ----------------------------------------
RANGE_BRIDGE=vmbr1
RANGE_VLAN=66
RANGE_CIDR=10.66.0.0/24
RANGE_GATEWAY=10.66.0.1
# Management network allowed NEW connections INTO the range (verifiers/SSH):
MANAGEMENT_CIDR=10.0.0.0/24

# --- Isolated red-runner (F01) ------------------------------------------------------
# ssh = the ONLY production-approved transport (fixed target, pinned key files).
# local-dev is FIXTURE-ONLY: it requires ALLOW_LOCAL_DEV_FIXTURE=1 (isolated
# synthetic acceptance fixtures) and is forbidden in production regardless.
RUNNER_TRANSPORT=ssh
# ALLOW_LOCAL_DEV_FIXTURE=1   # isolated synthetic fixtures only — keep unset
RUNNER_SSH_TARGET=runner@10.66.0.9
RUNNER_SSH_KEY_PATH=/etc/sparring-range/runner_ed25519
RUNNER_SSH_KNOWN_HOSTS=/etc/sparring-range/runner_known_hosts
RUNNER_COMMAND_TIMEOUT_S=120
RUNNER_MAX_OUTPUT_BYTES=8000

# --- Verifier management channel -----------------------------------------------------
VERIFIER_SSH_USER=root
VERIFIER_SSH_KEY_PATH=/etc/sparring-range/verifier_ed25519
VERIFIER_EXEC_TIMEOUT_S=30

# --- Golden templates / deploy --------------------------------------------------------
TEMPLATE_VMID_WEB=9001
TEMPLATE_VMID_WIN_DC=9002
TEMPLATE_VMID_WIN10=9003
TEMPLATE_VMID_LINUX=9004
DEPLOY_VMID_BASE=210

# --- Model serving (OpenAI-compatible; F18) --------------------------------------------
LLM_BASE_URL=http://gpu.lab.local:8001/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL_RED=qwen2.5-14b-instruct
LLM_MODEL_COACH=qwen2.5-32b-instruct
LLM_TIMEOUT_S=120
# Bounded priority gateway: hints jump ahead of batch AARs; queue overflow →
# visible 503, never unbounded memory.
MODEL_QUEUE_MAX=32
MODEL_HINT_MAX_WAIT_S=150
MODEL_RECOVERY_INTERVAL_S=60

# --- Safety (F02) ------------------------------------------------------------------------
SAFETY_STATE_FILE=/var/lib/sparring-range/safety_state
# Fresh-evidence requirement for /run (baseline check + operator datapath
# proof must be newer than this and match current config identity):
SAFETY_EVIDENCE_MAX_AGE_H=24
# static = isolation is OPERATOR-MANAGED (nft rulesets installed via the
# deployment boundary; verified by the runbook + packet acceptance layer).
# The runtime never executes nft/host commands; VM cessation is the broker.
# DATAPATH_CONTROLLER=nft was REMOVED from the runtime (milestone 02).
DATAPATH_CONTROLLER=static
KILLSWITCH_SCRIPT=infra/firewall/killswitch.sh
NFT_BIN=nft
# Operator-side helpers for the standalone scripts (the API never uses these):
# NFT_COMMAND_PREFIX=sudo

# --- Bastion (recording SSH proxy, F16) ---------------------------------------------------
BASTION_ADDRESS=10.66.0.2
BASTION_LISTEN_HOST=0.0.0.0
BASTION_LISTEN_PORT=2222
BASTION_HOST_KEY_PATH=/etc/sparring-range/bastion_ed25519
# Member PUBLIC keys file ("username ssh-ed25519 AAAA..." lines) provisioned
# by the operator; the bastion authenticates BOTH member key and session token.
BASTION_AUTHORIZED_KEYS_FILE=/etc/sparring-range/member_keys
# Pinned host keys for range targets (required in production — no TOFU):
BASTION_TARGETS_KNOWN_HOSTS=/etc/sparring-range/target_known_hosts
# Bastion's own capability (scope=bastion, minted via POST /admin/service_tokens):
# dev compose: mint it with `rangectl bootstrap`, paste it into SR_DEV_BASTION_TOKEN below.
SR_BASTION_TOKEN=PROVISION-ONCE
# --- dev compose bootstrap only (docs/OPERATOR_RUNBOOK.md §0) -------------------------------
# Operator key dir the seed-bastion-keys one-shot reads (authorized_keys +
# target_known_hosts; SECRET material, never committed):
# SR_DEPLOY_KEYS_DIR=./deploy/bastion
# SR_DEV_BASTION_TOKEN=<minted bastion capability; feeds the bastion container>
RECORDINGS_DIR=/var/lib/sparring-range/recordings
RECORDING_MAX_BYTES=33554432

# --- Telemetry ingest (F09) ----------------------------------------------------------------
INGEST_MAX_BODY_EVENTS=500
# Hosts run telemetry/shipper.py with:
#   SR_API_URL, SR_TELEMETRY_TOKEN (scope=telemetry, host-bound), SR_HOST, SR_SPOOL_DIR
