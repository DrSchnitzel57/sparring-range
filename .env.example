# ============================================================
# sparring-range — every required env var, documented, NO SECRETS
# Copy to .env (gitignored) and fill in for your infrastructure.
# ============================================================

# --- Database -----------------------------------------------------------------
# URL used by the API/CLI (application role; no UPDATE/DELETE on events).
POSTGRES_URL=postgresql+psycopg2://sr_app:CHANGE_ME@localhost:5432/sparring_range
# Migration URL (schema owner role; used only by `rangectl db migrate`).
POSTGRES_URL_OWNER=postgresql+psycopg2://sr_owner:CHANGE_ME@localhost:5432/sparring_range
# Application DB role name (grants in migrations target this role).
DB_APP_ROLE=sr_app

# --- API (single front door; the CLI and the web app are both clients) ---------
API_BASE_URL=http://localhost:8000

# --- Proxmox (control plane) ----------------------------------------------------
PROXMOX_HOST=r740.lab.local
PROXMOX_USER=root@pam
# API token, format user@realm!tokenname — created by Drew in the Proxmox UI.
PROXMOX_TOKEN_ID=automation!sparring
PROXMOX_TOKEN_SECRET=CHANGE_ME

# --- Range network ---------------------------------------------------------------
# Proxmox bridge on the range VLAN (no WAN egress — enforced in infra/firewall).
RANGE_BRIDGE=vmbr1
RANGE_VLAN=66
# bastion LXC address on the range side.
BASTION_ADDRESS=10.66.0.2
# Kali container the red agent executes inside.
KALI_CONTAINER=kali-red-01

# --- Golden image templates (VMIDs you snapshotted in M1) ------------------------
TEMPLATE_VMID_WEB=9001
TEMPLATE_VMID_WIN_DC=9002
TEMPLATE_VMID_WIN10=9003
TEMPLATE_VMID_LINUX=9004

# --- LLM serving (OpenAI-compatible endpoint on the GPU box) ---------------------
LLM_BASE_URL=http://gpu.lab.local:8000/v1
LLM_API_KEY=dummy
# Fast model for the red loop; big model for the coach (may be the same).
LLM_MODEL_RED=qwen2.5-14b-instruct
LLM_MODEL_COACH=qwen2.5-32b-instruct

# --- Bastion / recordings ----------------------------------------------------------
RECORDINGS_DIR=/var/lib/sparring-range/recordings
# SSH host key the bastion presents (generated by infra script; path on bastion LXC).
BASTION_HOST_KEY_PATH=/etc/sparring-range/bastion_ed25519
