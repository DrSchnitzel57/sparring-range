# Secrets and identity material must never enter image layers (audit F07).
# .gitignore does NOT apply to Docker build contexts — this file does.
.env
.env.*
!.env.example
*.pem
*.key
id_*
*_ed25519
*_rsa
known_hosts

# Recorded evidence (may contain sensitive session content)
recordings/
*.cast

# VCS / caches / local environments
.git
.gitignore
.pytest_cache
__pycache__
*.pyc
*.egg-info
.venv
venv
.mypy_cache
.ruff_cache

# Frontend build artifacts (web is deployed separately)
web/node_modules
web/.next

# Test scratch / operator notes / audit scratch
tests/.pytest_cache
.opencode-work
tools/diagnostics
audit
playwright-report
.playwright-cli
